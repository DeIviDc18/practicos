#include <iostream>
#include <string>
using namespace std;
int main() {
   //promedio de notas de un estudiante (3 notas)
    string nombre;
    int a,b,c;
    int p;   //dato aparte para promedio

    cout<< "ingrese nombre del estudiante: ";
    getline(cin,nombre);             //nombre
    cout<<"ingrese primera nota: ";
    cin >> a;
    cout<<"ingrese segunda nota: ";
    cin >> b;
    cout<<"ingrese tercera nota: ";
    cin >> c;

    p=(a+b+c)/3;        //se pone el calculo despues de pedir los datos para q no tenga problemas

    cout<<"El promedio del estudiante "<< nombre << " es: "<<p<<endl;     //todo en una linea

    return 0;
}


