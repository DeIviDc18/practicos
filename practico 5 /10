#include <iostream>
using namespace std;

int main() {
    int N;
    int d, total = 0, mayores = 0, cantidad = 0;
    cout << "Numero de transacciones: ";
    cin >> N;
    while (N > 0) {
        d = N % 10;
        total = total + d;
        cantidad = cantidad + 1;
        if (d > 5)
            mayores = mayores + 1;
        N = N / 10;
    }
    cout << "Transacciones realizadas = " << cantidad << endl;
    cout << "Transacciones mayores a 5 = " << mayores << endl;
    cout << "Total acumulado = " << total << endl;
    return 0;
}
