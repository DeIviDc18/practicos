#include <iostream>
using namespace std;

int main() {
    int N;
    int d, total = 0, apps = 0, mayores = 0;
    cout << "Numero (cada digito = horas de una app): ";
    cin >> N;
    while (N > 0) {
        d = N % 10;
        total = total + d;
        apps = apps + 1;
        if (d > 5)
            mayores = mayores + 1;
        N = N / 10;
    }
    cout << "Total de horas = " << total << endl;
    cout << "Apps con mas de 5 horas = " << mayores << endl;
    cout << "Promedio = " << (double)total / apps << endl;
    return 0;
}
