#include <iostream>
using namespace std;

int main() {
    int N;
    int d;
    bool valido = true;
    cout << "Numero en base 8: ";
    cin >> N;
    while (N > 0) {
        d = N % 10;
        if (d > 7)
            valido = false;
        N = N / 10;
    }
    if (valido)
        cout << "Numero valido en base 8" << endl;
    else
        cout << "Numero invalido (tiene digitos 8 o 9)" << endl;
    return 0;
}
