#include <iostream>
using namespace std;

int main() {
    int N;
    int d, pares = 0, suma = 0, limite;
    cout << "Codigo: ";
    cin >> N;
    cout << "La suma de digitos debe superar: ";
    cin >> limite;
    while (N > 0) {
        d = N % 10;
        suma = suma + d;
        if (d % 2 == 0)
            pares = pares + 1;
        N = N / 10;
    }
    if (pares >= 2 && suma > limite)
        cout << "Codigo SEGURO" << endl;
    else
        cout << "Codigo NO seguro" << endl;
    return 0;
}
