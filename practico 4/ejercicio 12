#include <iostream>
using namespace std;

int main() {
    int A, B, r;
    cout << "A: ";
    cin >> A;
    cout << "B: ";
    cin >> B;
    int a = A, b = B;
    while (b != 0) {
        r = a % b;
        a = b;
        b = r;
    }
    // ahora 'a' es el MCD
    cout << "MCM = " << (A * B) / a << endl;
    return 0;
}
