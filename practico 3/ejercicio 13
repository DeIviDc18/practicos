#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main() {

    double a, b, c;
    cout << "a b c: ";
    cin >> a >> b >> c;
    if (a == 0) {
        if (b == 0) {
            if (c == 0)
                cout << "Identidad 0 = 0: infinitas soluciones" << endl;
            else
                cout << "Ecuacion degenerada: sin solucion" << endl;
        } else {
            cout << "Ecuacion lineal: x = " << -c / b + 0.0 << endl;
        }
    } else {
        double disc = b * b - 4 * a * c;
        if (disc > 0) {
            cout << "Dos raices reales distintas:" << endl;
            cout << "x1 = " << (-b + sqrt(disc)) / (2 * a) << endl;
            cout << "x2 = " << (-b - sqrt(disc)) / (2 * a) << endl;
        } else if (disc == 0) {
            cout << "Raiz real doble: x = " << -b / (2 * a) + 0.0 << endl;
        } else {
            double real = -b / (2 * a) + 0.0;
            double imag = sqrt(-disc) / (2 * a);
            cout << "Raices complejas conjugadas:" << endl;
            cout << "x1 = " << real << " + " << fabs(imag) << "i" << endl;
            cout << "x2 = " << real << " - " << fabs(imag) << "i" << endl;
        }
    }
    return 0;
}

