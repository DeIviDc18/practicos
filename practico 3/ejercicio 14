#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    int c1, c2, c3, c4, c5;
    cout << "Cantidad de Saltena de pollo (3.50 Bs): ";
    cin >> c1;
    cout << "Cantidad de Saltena de carne (4.00 Bs): ";
    cin >> c2;
    cout << "Cantidad de Empanada de queso (3.00 Bs): ";
    cin >> c3;
    cout << "Cantidad de Refresco 500ml (5.00 Bs): ";
    cin >> c4;
    cout << "Cantidad de Agua mineral (3.00 Bs): ";
    cin >> c5;

    double s1 = c1 * 3.50, s2 = c2 * 4.00, s3 = c3 * 3.00;
    double s4 = c4 * 5.00, s5 = c5 * 3.00;
    int cantTotal = c1 + c2 + c3 + c4 + c5;
    double total = s1 + s2 + s3 + s4 + s5;

    cout << fixed << setprecision(2);
    cout << "\nITEM               PRECIO  CANT  PARCIAL\n";
    cout << "Saltena de pollo    3.50   " << setw(4) << c1 << "  " << setw(8) << s1 << endl;
    cout << "Saltena de carne    4.00   " << setw(4) << c2 << "  " << setw(8) << s2 << endl;
    cout << "Empanada de queso   3.00   " << setw(4) << c3 << "  " << setw(8) << s3 << endl;
    cout << "Refresco (500ml)    5.00   " << setw(4) << c4 << "  " << setw(8) << s4 << endl;
    cout << "Agua mineral        3.00   " << setw(4) << c5 << "  " << setw(8) << s5 << endl;
    cout << "TOTAL                      " << setw(4) << cantTotal << "  " << setw(8) << total << endl;

    return 0;
}
