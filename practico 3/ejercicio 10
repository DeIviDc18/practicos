#include <iostream>
using namespace std;
int main() {


    int d1, m1, d2, m2;
    cout << "Fecha inicial (DD MM): ";
    cin >> d1 >> m1;
    cout << "Fecha final   (DD MM): ";
    cin >> d2 >> m2;
    int dias1 = m1 * 30 + d1;
    int dias2 = m2 * 30 + d2;
    int diferencia = dias2 - dias1;
    cout << "Diferencia: " << diferencia / 30 << " meses " << diferencia % 30
         << " dias" << endl;
    return 0;
}
