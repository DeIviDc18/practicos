#include <iostream>
#include <cmath> // Para la función pow()

using namespace std;

int main() {
    double C; // Capital inicial
    double T; // Tasa de interés anual (%)
    double N; // Plazo en años

    cout << "EJERCICIO 1: INVERSIÓN CON CAPITALIZACIÓN MENSUAL" << endl;
    cout << "Ingrese el capital inicial (C): ";
    cin >> C;
    cout << "Ingrese la tasa de interés anual % (T): ";
    cin >> T;
    cout << "Ingrese el plazo en años (N): ";
    cin >> N;

    if (C <= 0 || N <= 0 || T < 0) {
        cout << "Error: Los valores de capital, tasa y plazo deben ser válidos." << endl;
    } else {
        // Tasa mensual expresada en decimal
        double tasaMensualDecimal = (T / 12.0) / 100.0;
        
        // Número total de periodos (meses)
        double totalMeses = N * 12.0;

        // Fórmula: M = C * (1 + tasaMensualDecimal)^totalMeses
        double M = C * pow(1.0 + tasaMensualDecimal, totalMeses);
        
        // Ganancia neta: G = M - C
        double G = M - C;

        cout << "Monto acumulado (M) : " << M << endl;
        cout << "Ganancia neta (G)   : " << G << endl;
    }
return 0;
}
